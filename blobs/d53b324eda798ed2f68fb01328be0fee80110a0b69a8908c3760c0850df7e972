def load_anchor(name):
    p = os.path.join(SCRATCH, name)
    if not os.path.exists(p):
        return None
    return base64.b64encode(open(p, "rb").read()).decode()


def generate(fid, anchor, aspect, scene, tries=3):
    ref = load_anchor(anchor)
    if ref is None:
        return {"id": fid, "error": "missing anchor " + anchor}
    prompt = ("Use the supplied reference image as the approved identity anchor.\n\n"
              + IDENTITY + MARKERS + WARDROBE + STYLE + EXCLUDE + "\nSCENE: " + scene +
              "\nAspect ratio: " + aspect + " vertical. Do not add any text or lettering to the image.")
    body = {"model": MODEL, "modalities": ["image", "text"],
            "messages": [{"role": "user", "content": [
                {"type": "text", "text": prompt},
                {"type": "image_url", "image_url": {"url": "data:image/png;base64," + ref}}]}]}
    last = None
    for attempt in range(tries):
        try:
            req = urllib.request.Request(
                "https://openrouter.ai/api/v1/chat/completions",
                data=json.dumps(body).encode(),
                headers={"Authorization": "Bearer " + KEY, "Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=420) as r:
                d = json.load(r)
            imgs = d["choices"][0]["message"].get("images") or []
            if not imgs:
                last = "no image returned"
                continue
            url = imgs[0]["image_url"]["url"] if isinstance(imgs[0].get("image_url"), dict) else imgs[0]["image_url"]
            raw = base64.b64decode(url.split(",", 1)[1])
            fp = os.path.join(OUT, fid + ".png")
            open(fp, "wb").write(raw)
            return {"id": fid, "file": fp, "anchor": anchor, "aspect": aspect,
                    "sha256": hashlib.sha256(raw).hexdigest(), "bytes": len(raw),
                    "model": MODEL, "attempt": attempt + 1}
        except urllib.error.HTTPError as e:
            last = "HTTP %s %s" % (e.code, e.read().decode()[:300])
        except Exception as e:
            last = "%s: %s" % (type(e).__name__, e)
        time.sleep(4)
    return {"id": fid, "error": last, "anchor": anchor}


def main():
    only = sys.argv[1:] if len(sys.argv) > 1 else None
    todo = [f for f in FRAMES if not only or f[0] in only]
    results = []
    for fid, anchor, aspect, scene in todo:
        t0 = time.time()
        res = generate(fid, anchor, aspect, scene)
        res["seconds"] = round(time.time() - t0, 1)
        results.append(res)
        print(json.dumps(res), flush=True)
        with open(os.path.join(SCRATCH, "gen_log.json"), "w") as fh:
            json.dump(results, fh, indent=1)
    ok = sum(1 for r in results if "file" in r)
    print("DONE ok=%d fail=%d" % (ok, len(results) - ok), flush=True)


if __name__ == "__main__":
    main()
