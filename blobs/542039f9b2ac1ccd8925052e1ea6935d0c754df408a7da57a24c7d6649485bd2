SRC_FACEBODY = os.path.join(HERE, "sheet_facebody.png")   # owner-supplied face & body reference

# ---------------------------------------------------------------- badge convention
BADGE_REF_W, BADGE_REF_H = 300, 66          # at a 1080 px canvas width
BADGE_CANVAS_REF = 1080
PLATE = (31, 31, 31)                        # #1f1f1f — matches delivered assets
PLATE_HEX = "#1f1f1f"
INK = (255, 255, 255)
FONT_DIR = "/usr/share/fonts/truetype/dejavu"
F_BOLD = os.path.join(FONT_DIR, "DejaVuSans-Bold.ttf")
F_REG = os.path.join(FONT_DIR, "DejaVuSans.ttf")
F_SERIF_B = os.path.join(FONT_DIR, "DejaVuSerif-Bold.ttf")

BADGE_TEXT = "AI-generated"
REF_GLYPH = (28, 15, 275, 48)               # glyph bbox inside the 300x66 reference plate

INTERNAL_STR = "INTERNAL ANCHOR SHEET — NOT FOR PUBLICATION"
BAND_ACCENT = (166, 38, 74)                 # maroon family, matches sheet accents
BAND_BG = (245, 241, 234)                   # light warm footer, so the dark badge plate reads as a badge
BAND_TITLE_INK = (32, 22, 16)
BAND_BODY_INK = (78, 66, 56)
BAND_PAD = 34


def font(path, size):
    return ImageFont.truetype(path, size)


def wrap(draw, text, fnt, max_w):
    """Greedy word wrap measured with the real font. Returns a list of lines."""
    out, line = [], ""
    for word in text.split():
        trial = (line + " " + word).strip()
        if line and draw.textlength(trial, font=fnt) > max_w:
            out.append(line)
            line = word
        else:
            line = trial
    if line:
        out.append(line)
    return out


def badge_image(width):
    """Render the exact AI-generated badge scaled to `width` (badge convention ratio)."""
    scale = width / BADGE_REF_W
    h = int(round(BADGE_REF_H * scale))
    fnt = font(F_BOLD, max(8, int(round(34 * scale))))
    img = Image.new("RGB", (width, h), PLATE)
    d = ImageDraw.Draw(img)
    bx0, by0, _, _ = fnt.getbbox(BADGE_TEXT)
    d.text((REF_GLYPH[0] * scale - bx0, REF_GLYPH[1] * scale - by0), BADGE_TEXT, font=fnt, fill=INK)
    return img


def badge_size_for(canvas_w):
    scale = canvas_w / BADGE_CANVAS_REF
    return int(round(BADGE_REF_W * scale)), int(round(BADGE_REF_H * scale))


def append_disclosure_band(src_path, out_path, title, notes):
    """Append the §7.1 disclosure band below the sheet. Original pixels untouched."""
    src = Image.open(src_path).convert("RGB")
    W, H = src.size
    bw, bh = badge_size_for(W)

    f_title = font(F_BOLD, 30)
    f_body = font(F_REG, 22)
    f_small = font(F_REG, 19)

    scratch = ImageDraw.Draw(Image.new("RGB", (10, 10)))
    left = 56
    right_edge = W - bw - 56 - 44          # keep clear of the badge
    text_w = right_edge - left
    title_lines = wrap(scratch, title, f_title, text_w)
    note_lines = [ln for n in notes for ln in wrap(scratch, n, f_body, text_w)]

    body_h = (len(title_lines) * 40) + (len(note_lines) * 30) + 28 + 26
    band_h = max(body_h + 2 * BAND_PAD, bh + 2 * BAND_PAD, 132)

    out = Image.new("RGB", (W, H + band_h), BAND_BG)
    out.paste(src, (0, 0))
    d = ImageDraw.Draw(out)
    d.rectangle([0, H, W, H + 5], fill=BAND_ACCENT)

    y = H + BAND_PAD
    for ln in title_lines:
        d.text((left, y), ln, font=f_title, fill=BAND_TITLE_INK)
        y += 40
    y += 4
    for ln in note_lines:
        d.text((left, y), ln, font=f_body, fill=BAND_BODY_INK)
        y += 30
    y += 6
    d.text((left, y), INTERNAL_STR + "  ·  Persona Bible §7.1 disclosure applied by the Creative Director",
           font=f_small, fill=(112, 98, 86))

    out.paste(badge_image(bw), (W - bw - 56, H + (band_h - bh) // 2))
    out.save(out_path, "PNG", optimize=True)
    return {"output": os.path.basename(out_path), "size": [W, H + band_h],
            "original_size": [W, H], "band_y": H, "band_h": band_h,
            "badge_bbox": [W - bw - 56, H + (band_h - bh) // 2, bw, bh]}


