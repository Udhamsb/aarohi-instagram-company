def build_wardrobe_sheet(out_path, W=1536, cols=2, gap=20, margin=48, cell_pad=20):
    maroon = (140, 24, 60)
    ink = (32, 22, 16)
    sub = (92, 76, 64)
    reject_col = (150, 32, 40)

    f_brand = font(F_SERIF_B, 60)
    f_h1 = font(F_BOLD, 31)
    f_h2 = font(F_REG, 22)
    f_name = font(F_BOLD, 26)
    f_week = font(F_BOLD, 18)
    f_spec = font(F_REG, 20)
    f_rej = font(F_REG, 19)
    f_small = font(F_REG, 18)

    scratch = ImageDraw.Draw(Image.new("RGB", (10, 10)))
    text_w = W - 2 * margin
    cell_w = (W - 2 * margin - (cols - 1) * gap) // cols
    inner_w = cell_w - 2 * cell_pad

    # ---- measure header
    brand_h = 74
    h1_lines = wrap(scratch, "WARDROBE & MODESTY REFERENCE  v1.0", f_h1, text_w)
    h2_lines = []
    for para in ("Approved everyday silhouettes — Persona Bible §7.3. Garment specification sheet.",
                 "The owner-supplied anchor sheets carry no wardrobe reference; this sheet defines the only "
                 "garments a Week 1 frame may show."):
        h2_lines += wrap(scratch, para, f_h2, text_w)
    header_h = brand_h + len(h1_lines) * 38 + len(h2_lines) * 30 + 34

    # ---- measure each card
    cards = []
    for item in WARDROBE:
        spec_lines = [ln for s in item["spec"] for ln in wrap(scratch, "• " + s, f_spec, inner_w)]
        rej_lines = wrap(scratch, "REJECT: " + item["reject"], f_rej, inner_w)
        week_lines = wrap(scratch, item["week1"], f_week, inner_w)
        name_lines = wrap(scratch, item["name"], f_name, inner_w)
        h = (cell_pad + len(name_lines) * 32 + len(week_lines) * 24 + 10
             + len(spec_lines) * 26 + 6 + len(rej_lines) * 24 + cell_pad)
        cards.append({"item": item, "h": h, "name_lines": name_lines, "week_lines": week_lines,
                      "spec_lines": spec_lines, "rej_lines": rej_lines})

    rows = [cards[i:i + cols] for i in range(0, len(cards), cols)]
    row_heights = [max(c["h"] for c in row) for row in rows]

    rules_lines = []
    for ln in USAGE_RULES:
        rules_lines += wrap(scratch, ln, f_small, text_w)
    rules_h = 44 + len(rules_lines) * 25 + 20

    band_h = max(150, badge_size_for(W)[1] + 3 * BAND_PAD)
    body_top = header_h
    body_h = sum(row_heights) + gap * (len(rows) - 1)
    H = body_top + body_h + 28 + rules_h + band_h

    img = Image.new("RGB", (W, H), (252, 249, 245))
    d = ImageDraw.Draw(img)

    # ---- header
    d.text((margin, 30), "AAROHI", font=f_brand, fill=ink)
    y = 30 + brand_h
    for ln in h1_lines:
        d.text((margin, y), ln, font=f_h1, fill=maroon)
        y += 38
    for ln in h2_lines:
        d.text((margin, y), ln, font=f_h2, fill=sub)
        y += 30
    d.line([margin, header_h - 14, W - margin, header_h - 14], fill=(216, 206, 194), width=2)

    # ---- cards
    y = body_top
    for row, row_h in zip(rows, row_heights):
        for c, card in enumerate(row):
            x = margin + c * (cell_w + gap)
            d.rectangle([x, y, x + cell_w, y + row_h], fill=(255, 255, 255), outline=(222, 212, 200), width=2)
            d.rectangle([x, y, x + cell_w, y + 5], fill=maroon)
            ty = y + cell_pad + 4
            d.text((x + cell_pad, ty), card["item"]["n"], font=f_name, fill=maroon)
            num_w = d.textlength(card["item"]["n"] + "  ", font=f_name)
            for i, ln in enumerate(card["name_lines"]):
                d.text((x + cell_pad + num_w, ty + i * 32), ln, font=f_name, fill=ink)
            ty += len(card["name_lines"]) * 32 + 4
            d.text((x + cell_pad, ty), "WEEK 1: " + card["week_lines"][0], font=f_week, fill=sub)
            ty += 24 * len(card["week_lines"])
            # remaining week lines (rare) — indent
            for extra in card["week_lines"][1:]:
                d.text((x + cell_pad + 12, ty), extra, font=f_week, fill=sub)
                ty += 24
            ty += 10
            for ln in card["spec_lines"]:
                d.text((x + cell_pad, ty), ln, font=f_spec, fill=ink)
                ty += 26
            ty += 6
            for ln in card["rej_lines"]:
                d.text((x + cell_pad, ty), ln, font=f_rej, fill=reject_col)
                ty += 24
        y += row_h + gap

    # ---- usage rules
    y += 28 - gap
    d.text((margin, y), "USAGE RULES (binding)", font=f_h1, fill=maroon)
    y += 44
    for ln in rules_lines:
        d.text((margin, y), ln, font=f_small, fill=ink)
        y += 25

    # ---- disclosure band
    band_y = H - band_h
    d.rectangle([0, band_y, W, H], fill=BAND_BG)
    d.rectangle([0, band_y, W, band_y + 5], fill=maroon)
    bw, bh = badge_size_for(W)
    txt_w = W - bw - 56 - 44 - margin
    by = band_y + BAND_PAD
    for ln in wrap(scratch, "AI-generated reference — Aarohi Kapoor, fictional persona @aarohi.kapoor.diaries",
                   font(F_BOLD, 26), txt_w):
        d.text((margin, by), ln, font=font(F_BOLD, 26), fill=BAND_TITLE_INK)
        by += 34
    d.text((margin, by), INTERNAL_STR + "  ·  §7.1/§7.3 disclosure applied by the Creative Director",
           font=f_small, fill=(112, 98, 86))
    img.paste(badge_image(bw), (W - bw - 56, band_y + (band_h - bh) // 2))
    img.save(out_path, "PNG", optimize=True)
    return {"output": os.path.basename(out_path), "size": [W, H]}


def verify_original_pixels(src_path, out_path, band_y):
    """Prove the original sheet region is byte-identical inside the re-issued file."""
    src = Image.open(src_path).convert("RGB")
    out = Image.open(out_path).convert("RGB")
    a = src.crop((0, 0, src.width, band_y)).tobytes()
    b = out.crop((0, 0, src.width, band_y)).tobytes()
    return a == b


def main():
    results = {}
    char_out = os.path.join(HERE, "AAROHI_REFERENCE_PACK_v2_CHARACTER_SHEET.png")
    fb_out = os.path.join(HERE, "AAROHI_REFERENCE_PACK_v2_FACE_BODY_SHEET.png")

    results["character_sheet"] = append_disclosure_band(
        SRC_CHAR, char_out,
        "AI-generated reference — AAROHI CHARACTER SHEET v2.0 (re-issued v2.1)",
        ["Reference pack §7.1 disclosure. The original character-sheet pixels are unmodified; this band is appended below them.",
         "Usage: identity anchor for face, hair and expression. The 'Open Hair (default)' panel is a HAIR-ONLY reference — crop head and hair, never inherit its garment."])

    results["face_body_sheet"] = append_disclosure_band(
        SRC_FACEBODY, fb_out,
        "AI-generated reference — AAROHI FACE & BODY REFERENCE (re-issued v2.1)",
        ["Reference pack §7.1 disclosure. The original face-and-body pixels are unmodified; this band is appended below them.",
         "Usage: primary face anchor plus supporting angles. Body proportions only — wardrobe is governed by the §7.3 wardrobe & modesty sheet."])

    wardrobe_out = os.path.join(HERE, "AAROHI_WARDROBE_REFERENCE_v1.png")
    results["wardrobe_sheet"] = build_wardrobe_sheet(wardrobe_out)

    for k, v in results.items():
        v["source"] = os.path.basename(SRC_CHAR if k == "character_sheet" else
                                       SRC_FACEBODY if k == "face_body_sheet" else "(new composition)")
    results["character_sheet"]["original_pixels_unmodified"] = verify_original_pixels(
        SRC_CHAR, char_out, results["character_sheet"]["band_y"])
    results["face_body_sheet"]["original_pixels_unmodified"] = verify_original_pixels(
        SRC_FACEBODY, fb_out, results["face_body_sheet"]["band_y"])

    for k, v in results.items():
        p = os.path.join(HERE, v["output"])
        v["sha256"] = hashlib.sha256(open(p, "rb").read()).hexdigest()
        v["bytes"] = os.path.getsize(p)
        print(k, v["output"], v["size"], v["sha256"][:16], v["bytes"],
              "unmodified=" + str(v.get("original_pixels_unmodified", "n/a")))

    with open(os.path.join(HERE, "build_reference_pack.result.json"), "w") as fh:
        json.dump(results, fh, indent=1)


if __name__ == "__main__":
    main()
